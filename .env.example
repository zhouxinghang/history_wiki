# Development example only. Replace placeholders; never commit real credentials.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/history_wiki?sslmode=disable
HTTP_ADDRESS=:8080
PUBLIC_BASE_URL=http://localhost:5173
SESSION_COOKIE_NAME=__Host-history_wiki_session
CSRF_COOKIE_NAME=__Host-history_wiki_csrf
TRUSTED_PROXY_COUNT=0
LOG_LEVEL=info
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
SESSION_IDLE_TIMEOUT=8h
SESSION_MAX_LIFETIME=168h
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
